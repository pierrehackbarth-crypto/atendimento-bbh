# Configuração do Atendimentos com IA / Ficha de atendimento
# Copie para ".env" e preencha. NUNCA compartilhe o .env.

# --- OpenAI (IA) ---
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=
# gpt-4o-transcribe será desligado pela OpenAI em 26/02/2027; prefira gpt-transcribe
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_USE_FILES_API=false
OPENAI_FAKE=false

# --- Banco de dados ---
# Local (um computador): sqlite:///./data/atendimento.db
# Servidor: postgresql+psycopg://usuario:senha@host:5432/atendimento
DATABASE_URL=sqlite:///./data/atendimento.db

# --- Armazenamento (arquivos criptografados) ---
STORAGE_DIR=./storage
STORAGE_AUDIO_DIR=./storage_audio_tmp
# gere com: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=

# --- Sessão ---
# true no servidor com HTTPS; false só para uso em localhost
SESSION_COOKIE_SECURE=true
SESSION_HOURS=12

# --- Processamento ---
RUN_WORKER_IN_PROCESS=true
MAX_AI_CALLS_PER_USER_PER_DAY=200
TEMP_AUDIO_TTL_HOURS=72
